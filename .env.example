# Runtime
NODE_ENV=development            # development | test | production
PORT=3000
# CORS: comma-separated list of origins; empty = reject all cross-origin
CORS_ORIGINS=http://localhost:5173

# Database (postgres in docker/docker-compose.yml)
DATABASE_URL=postgresql://app:app@localhost:5432/app
DATABASE_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
# JWT secrets: MUST be at least 32 chars and DIFFERENT from each other. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-random-32-chars-or-more-a
JWT_REFRESH_SECRET=change-me-to-a-random-32-chars-or-more-b
JWT_ACCESS_TTL=900          # seconds (15 minutes)
JWT_REFRESH_TTL=604800      # seconds (7 days)
AUTH_REQUIRE_EMAIL_VERIFICATION=false   # true = require clicking the verification link before login (needs Plan 3)

# Seeding (change in production!)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
