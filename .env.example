# Runtime
NODE_ENV=development            # development | test | production
PORT=3000
# CORS: daftar origin dipisah koma, kosong = tolak semua cross-origin
CORS_ORIGINS=http://localhost:5173

# Database (postgres di docker/docker-compose.yml)
DATABASE_URL=postgresql://app:app@localhost:5432/app
DATABASE_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
# Secret JWT: WAJIB min 32 karakter dan BERBEDA satu sama lain. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=ganti-dengan-random-32-karakter-atau-lebih-a
JWT_REFRESH_SECRET=ganti-dengan-random-32-karakter-atau-lebih-b
JWT_ACCESS_TTL=900          # detik (15 menit)
JWT_REFRESH_TTL=604800      # detik (7 hari)
AUTH_REQUIRE_EMAIL_VERIFICATION=false   # true = wajib klik link verifikasi sebelum login (butuh Plan 3)

# Seeding (ganti di production!)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
