# Runtime
NODE_ENV=development            # development | test | production
PORT=3000
# CORS: comma-separated list of origins; empty = reject all cross-origin
CORS_ORIGINS=http://localhost:5173

# Database (postgres in docker/docker-compose.yml)
DATABASE_URL=postgresql://app:app@localhost:5432/app
DATABASE_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                         # leave empty if no password (local dev)

# Auth
# JWT secrets: MUST be at least 32 chars and DIFFERENT from each other. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-random-32-chars-or-more-a
JWT_REFRESH_SECRET=change-me-to-a-random-32-chars-or-more-b
JWT_ACCESS_TTL=900          # seconds (15 minutes)
JWT_REFRESH_TTL=604800      # seconds (7 days)
PASSWORD_RESET_TTL=3600     # seconds (1 hour)
AUTH_REQUIRE_EMAIL_VERIFICATION=false   # true = require clicking the verification link before login (needs Plan 3)

# Google OAuth (register GOOGLE_CALLBACK_URL in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/google/callback
GOOGLE_OAUTH_STATE_TTL=600               # seconds (10 minutes)
GOOGLE_OAUTH_CODE_TTL=60                 # seconds (1 minute)
GOOGLE_REAUTH_STATE_TTL=600              # seconds (10 minutes)
GOOGLE_REAUTH_CODE_TTL=60                # seconds (1 minute)

# Mail
MAIL_DRIVER=log                         # log | resend (must be 'resend' in production)
MAIL_FROM="Nest Foundry <noreply@example.com>"
RESEND_API_KEY=                         # required only when MAIL_DRIVER=resend
FRONTEND_URL=http://localhost:5173      # base URL for links in emails
EMAIL_VERIFICATION_TTL=86400            # seconds (24 hours)

# Seeding (change in production!)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
